# Copy this file to .env and fill in your own API keys.
#   Windows (PowerShell):  copy .env.example .env
#   macOS/Linux:           cp .env.example .env

# Required — Gemini: query generation, AQR routing, retrieval-grounded drafts,
# DDA, SR, and all baseline methods (01, 03, 04, cross/).
GEMINI_API_KEY=

# Required — Claude: QA ground-truth dataset generation only (02_generate_qa_claude.py).
ANTHROPIC_API_KEY=

# Required — OpenAI: independent LLM-as-judge, kept deliberately on a
# different model family from the generator to avoid self-evaluation bias
# (03_run_experiment.py, 04_ablation.py, Sensitivity_analysis.py).
OPENAI_API_KEY=

# Optional — only needed for cross/run_cross_backbone.py (hosted Hugging
# Face Inference backbones for the robustness check, e.g. Qwen2.5-1.5B,
# Phi-3-mini). Not required for the main pipeline (01-05).
HF_TOKEN=
